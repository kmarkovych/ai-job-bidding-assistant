{
  "manifest_version": 3,
  "name": "AI Job Bidding Assistant",
  "version": "1.0.0",
  "description": "AI-powered assistant to help you create compelling job proposals and bids",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://www.freelancer.com/*",
    "https://www.fiverr.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/*/apply/*",
        "https://www.upwork.com/jobs/*",
        "https://www.freelancer.com/projects/*",
        "https://www.fiverr.com/*/requests/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
